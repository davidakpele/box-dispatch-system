{
  "uid": "box-dispatch-main",
  "title": "Box Dispatch System — Overview",
  "description": "Production metrics for the Box Dispatch System API",
  "tags": ["box-dispatch", "spring-boot", "api"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },

  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "query": "label_values(up{job=\"box-dispatch-app\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {}
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
        "expr": "changes(process_start_time_seconds{job=\"box-dispatch-app\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "App Restart",
        "iconColor": "blue",
        "enable": true
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "title": "App Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "up{job=\"box-dispatch-app\"}",
        "legendFormat": "Status"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
        ]
      }
    },

    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "(time() - process_start_time_seconds{job=\"box-dispatch-app\"}) / 3600",
        "legendFormat": "Hours"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "h"
      }
    },

    {
      "id": 3,
      "title": "Total Requests (5m)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "sum(increase(http_server_requests_seconds_count{job=\"box-dispatch-app\"}[5m]))",
        "legendFormat": "Requests"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },

    {
      "id": 4,
      "title": "Error Rate (5m)",
      "type": "stat",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\"}[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percent",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      }
    },

    {
      "id": 5,
      "title": "p99 Latency",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
        "legendFormat": "p99 ms"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "ms",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]
        }
      }
    },

    {
      "id": 6,
      "title": "JVM Heap Used",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "jvm_memory_used_bytes{job=\"box-dispatch-app\",area=\"heap\"} / jvm_memory_max_bytes{job=\"box-dispatch-app\",area=\"heap\"} * 100",
        "legendFormat": "Heap %"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percent",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        }
      }
    },

    {
      "id": 7,
      "title": "HTTP Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\"}[1m])) by (uri, method)",
        "legendFormat": "{{method}} {{uri}}"
      }],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 8,
      "title": "HTTP Response Status Breakdown",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\",status=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\",status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Client Error"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"box-dispatch-app\",status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Server Error"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx Success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx Client Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5xx Server Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 9,
      "title": "Response Time Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_server_requests_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
          "legendFormat": "p90"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 10,
      "title": "Active HTTP Connections",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "tomcat_connections_current_connections{job=\"box-dispatch-app\"}",
        "legendFormat": "Active Connections"
      },
      {
        "expr": "tomcat_connections_keepalive_current_connections{job=\"box-dispatch-app\"}",
        "legendFormat": "Keep-Alive Connections"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },

    {
      "id": 11,
      "title": "JVM Memory",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"box-dispatch-app\",area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"box-dispatch-app\",area=\"heap\"}",
          "legendFormat": "Heap Max"
        },
        {
          "expr": "jvm_memory_used_bytes{job=\"box-dispatch-app\",area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },

    {
      "id": 12,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"box-dispatch-app\"}",
          "legendFormat": "Live"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=\"box-dispatch-app\"}",
          "legendFormat": "Daemon"
        },
        {
          "expr": "jvm_threads_peak_threads{job=\"box-dispatch-app\"}",
          "legendFormat": "Peak"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },

    {
      "id": 13,
      "title": "GC Pause Time",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"box-dispatch-app\"}[1m])) by (action, cause)",
        "legendFormat": "{{action}} ({{cause}})"
      }],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },

    {
      "id": 14,
      "title": "HikariCP Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"box-dispatch-app\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"box-dispatch-app\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"box-dispatch-app\"}",
          "legendFormat": "Pending"
        },
        {
          "expr": "hikaricp_connections_max{job=\"box-dispatch-app\"}",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },

    {
      "id": 15,
      "title": "HikariCP Acquisition Time (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket{job=\"box-dispatch-app\"}[5m])) by (le)) * 1000",
        "legendFormat": "p95 Acquire ms"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },

    {
      "id": 16,
      "title": "PostgreSQL — Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "pg_stat_activity_count{job=\"postgres\"}",
        "legendFormat": "Connections by State: {{state}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 17,
      "title": "PostgreSQL — Transaction Rate",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 36, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=\"boxdispatch\"}[1m])",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"boxdispatch\"}[1m])",
          "legendFormat": "Rollbacks/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },

    {
      "id": 18,
      "title": "PostgreSQL — Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 36, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "pg_stat_database_blks_hit{job=\"postgres\",datname=\"boxdispatch\"} / (pg_stat_database_blks_hit{job=\"postgres\",datname=\"boxdispatch\"} + pg_stat_database_blks_read{job=\"postgres\",datname=\"boxdispatch\"}) * 100",
        "legendFormat": "Cache Hit %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },

    {
      "id": 19,
      "title": "Redis — Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "Used"
        },
        {
          "expr": "redis_memory_max_bytes{job=\"redis\"}",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    {
      "id": 20,
      "title": "Redis — Commands/s",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 43, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [{
        "expr": "rate(redis_commands_processed_total{job=\"redis\"}[1m])",
        "legendFormat": "Commands/s"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },

    {
      "id": 21,
      "title": "Redis — Hit/Miss Ratio",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 43, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[1m])",
          "legendFormat": "Hits/s"
        },
        {
          "expr": "rate(redis_keyspace_misses_total{job=\"redis\"}[1m])",
          "legendFormat": "Misses/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },

    {
      "id": 22,
      "title": "Application Logs (ERROR / WARN)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 50, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki-uid" },
      "targets": [{
        "expr": "{app=\"box-dispatch\", severity=~\"error|warning\"}",
        "legendFormat": ""
      }],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}